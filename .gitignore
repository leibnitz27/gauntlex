# gauntlex.xlsm is now tracked - it is self-contained (tiles embedded) and
# shipped from the repo. Rebuild from src\ with build\Build-Workbook.ps1 and
# commit it when you want a new release.

# Excel lock / temp files
~$*.xls*
*.tmp

# Loose screenshots / reference images dropped in the repo root
# (move keepers into reference/ to track them)
/*.png
/*.webp

# Sliced sprite tiles - regenerate with reference/slice-tiles.ps1
reference/genesis-tiles/

# Scratch contact sheet - regenerate with build/Make-TileSheet.ps1
reference/tilesheet.png

# Editor / OS
.DS_Store
Thumbs.db

# Spike build artifact
spike.xlsm
